# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careerforge

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (change in production)
JWT_SECRET=your-jwt-secret-key-here

# Redis Configuration (use rediss:// for TLS with Upstash)
REDIS_URL=rediss://default:<password>@<your-redis-host>.upstash.io:6379

# AI Microservices URLs (use Render URLs in production)
AI_SERVICE_URL=http://localhost:5001
COGNITIVE_SERVICE_URL=http://localhost:5002
